[ req ]
default_bits = 2048
default_keyfile = privkey.pem
distinguished_name = req_distinguished_name
x509_extensions = v3_req
prompt = no

[ req_distinguished_name ]
C = US
ST = California
L = San Francisco
O = Test Company
OU = IT Department
CN = local.test

[ v3_req ]
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = au.mit.test
DNS.2 = hh.mit.test
DNS.3 = pk.mit.test
DNS.4 = au.kri.test
DNS.5 = nz.kri.test
DNS.6 = au.nik.test
DNS.7 = in.nik.test
DNS.8 = au.bet.test
DNS.9 = fz.bet.test
DNS.10 = sc.bet.test
DNS.11 = bg.bet.test
DNS.12 = rte.bet.test
DNS.13 = au.m247ee.test
DNS.14 = au.m248ee.test
DNS.15 = au.uom.test
DNS.16 = mer.uom.test
DNS.17 = msp.uom.test
DNS.18 = sho.uom.test
DNS.19 = adv.uom.test
DNS.20 = cap.uom.test
DNS.21 = mgs.uom.test
DNS.22 = au.tot.test
DNS.23 = au.mit249.test
DNS.24 = hh.mit249.test
DNS.25 = pk.mit249.test
DNS.26 = au.m249.test
